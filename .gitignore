# macOS metadata
.DS_Store
._*

# Rebuildable executables and preset compilation cache.
# Historical plans in runs/ and test fixtures in profiles/ remain tracked.
/bin/
/profiles/compiled/

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Downloaded vendor packages and extracted native libraries
/evidence/*.apk
/evidence/android-arm64/

# Local analysis sessions and atomic JSON-write temporary files.
# Do not ignore all *.log: diagnostic logs can be important evidence.
/evidence/*.snapshot.json
*.json.tmp
# Advisory lock for cooperating apply/verify processes; not a device state file.
/.echo-b.lock

# Keep presets/, backups/, runs/, and headphone measurements tracked,
# including binary replies, saved write plans, and failure diagnostics.
